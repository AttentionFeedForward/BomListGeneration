# Flask 后端配置
# FLASK_HOST: Flask 应用监听的 IP 地址，0.0.0.0 表示监听所有网络接口。
FLASK_HOST=0.0.0.0
# FLASK_PORT: Flask 应用监听的端口号。
FLASK_PORT=5000
# FLASK_DEBUG: 是否开启调试模式。在生产环境中应设置为 False。
FLASK_DEBUG=True
# SECRET_KEY: Flask 应用的会话密钥。请务必在生产环境中设置为一个强随机字符串。
SECRET_KEY=your-secret-key-here

# 前端 API 基础 URL
# REACT_APP_API_BASE_URL: 前端应用调用后端 API 的基础 URL。
# 例如，如果后端运行在 http://localhost:5000，则设置为 http://localhost:5000/api
REACT_APP_API_BASE_URL=http://localhost:5000/api

# 其他前端配置 (可选)
# REACT_APP_DEBUG: 前端调试模式，可在开发环境中使用。
REACT_APP_DEBUG=true

# 需要在这里配置 LLM 的 API Key 和 Base URL。
OPENAI_API_KEY=
OPENAI_BASE_URL=
